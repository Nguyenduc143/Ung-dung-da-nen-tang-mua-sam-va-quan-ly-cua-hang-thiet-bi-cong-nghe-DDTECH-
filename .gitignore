# Dependencies
**/node_modules/
**/.pnp/
**/.pnp.js

# Build output
**/dist/
**/build/
**/out/
**/web-build/
**/.next/
**/.nuxt/
**/.vite/
**/*.tsbuildinfo

# Environment files and local secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.jks
**/*.keystore
**/*.mobileprovision
**/google-services.json
**/GoogleService-Info.plist

# Logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Tests and coverage
**/coverage/
**/.nyc_output/
**/test-results/
**/playwright-report/

# Expo / React Native
**/.expo/
**/.expo-shared/
**/expo-env.d.ts
**/android/.gradle/
**/android/app/build/
**/android/build/
**/android/local.properties
**/ios/Pods/
**/ios/build/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
**/*.xcuserstate

# Package-manager and tool caches
**/.npm/
**/.yarn/cache/
**/.yarn/unplugged/
**/.pnpm-store/
**/.cache/
**/.eslintcache
**/.turbo/

# Runtime-generated files
**/uploads/
**/tmp/
**/temp/
**/*.pid
**/*.pid.lock

# IDE settings
**/.idea/
**/.vscode/
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?

