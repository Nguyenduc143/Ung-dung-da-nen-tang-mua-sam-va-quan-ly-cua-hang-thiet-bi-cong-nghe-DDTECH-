NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ddtech
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_MAX=30
AUTH_FORGOT_PASSWORD_RATE_LIMIT_MAX=5
PASSWORD_RESET_EXPIRES_MINUTES=10
EMAIL_VERIFICATION_EXPIRES_MINUTES=10

# Bắt buộc ở production. Ví dụ Gmail: smtp.gmail.com / 587 / App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DDTECH <no-reply@ddtech.local>

ADMIN_WEB_ORIGIN=http://localhost:5173

# Đăng ký sandbox tại https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
VNPAY_MOBILE_RETURN_URL=ddtech://payment-result
VNPAY_EXPIRE_MINUTES=15
