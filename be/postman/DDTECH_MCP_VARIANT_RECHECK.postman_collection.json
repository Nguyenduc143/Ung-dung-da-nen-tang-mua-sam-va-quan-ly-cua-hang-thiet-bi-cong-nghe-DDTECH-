{
  "info": {
    "name": "DDTECH - MCP variant verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Test run snapshot; fixture records have been removed. Provision fresh test fixtures and credentials before rerunning. No production credentials included."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000/api",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "mcp-1789529893769@example.invalid",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login user",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"mcp-1789529893769-user@example.invalid\",\"password\":\"McpTest456!Ab\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const j=pm.response.json();",
              "pm.test('success',()=>pm.expect(j.success).to.eql(true));",
              "if(pm.response.code<300) pm.collectionVariables.set('accessToken',j.data.accessToken);",
              "if(pm.response.code<300) pm.collectionVariables.set('refreshToken',j.data.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login admin",
