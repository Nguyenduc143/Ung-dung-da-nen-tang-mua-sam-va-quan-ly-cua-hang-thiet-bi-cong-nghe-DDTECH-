{
  "info": {
    "_postman_id": "ddtech-3-folders-2026",
    "name": "DDTECH API - Admin User Cong khai",
    "description": "Collection test API DDTECH duoc chia thanh 3 folder: Admin, User va Cong khai. Hay dien email/password va cac ID trong Variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "userEmail", "value": "user@example.com", "type": "string" },
    { "key": "userPassword", "value": "Password123!", "type": "string" },
    { "key": "adminEmail", "value": "admin@example.com", "type": "string" },
    { "key": "adminPassword", "value": "Password123!", "type": "string" },
    { "key": "userAccessToken", "value": "", "type": "string" },
    { "key": "adminAccessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" },
    { "key": "addressId", "value": "1", "type": "string" },
    { "key": "productId", "value": "1", "type": "string" },
    { "key": "productSlug", "value": "", "type": "string" },
    { "key": "variantId", "value": "1", "type": "string" },
    { "key": "cartItemId", "value": "1", "type": "string" },
    { "key": "orderId", "value": "1", "type": "string" },
    { "key": "reviewId", "value": "1", "type": "string" },
    { "key": "promotionId", "value": "1", "type": "string" },
    { "key": "promotionCode", "value": "WELCOME10", "type": "string" },
    { "key": "notificationId", "value": "1", "type": "string" },
    { "key": "categoryId", "value": "1", "type": "string" },
    { "key": "brandId", "value": "1", "type": "string" },
    { "key": "shippingMethodId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Admin",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Users",
          "item": [
            { "name": "List users", "request": { "method": "GET", "url": "{{baseUrl}}/admin/users?page=1&limit=20" } },
            { "name": "Get user", "request": { "method": "GET", "url": "{{baseUrl}}/admin/users/{{userId}}" } },
            { "name": "Update user", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Admin updated user\",\n  \"role\": \"USER\",\n  \"status\": \"ACTIVE\"\n}" }, "url": "{{baseUrl}}/admin/users/{{userId}}" } }
          ]
        },
        {
          "name": "Catalog",
          "item": [
            { "name": "List categories (admin)", "request": { "method": "GET", "url": "{{baseUrl}}/admin/categories" } },
            { "name": "Create category", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Category Postman\",\n  \"slug\": \"category-postman\",\n  \"description\": \"Category test\"\n}" }, "url": "{{baseUrl}}/admin/categories" } },
            { "name": "Update category", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Category Postman Updated\"\n}" }, "url": "{{baseUrl}}/admin/categories/{{categoryId}}" } },
            { "name": "Delete category", "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/categories/{{categoryId}}" } },
            { "name": "List brands (admin)", "request": { "method": "GET", "url": "{{baseUrl}}/admin/brands" } },
            { "name": "Create brand", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Brand Postman\",\n  \"slug\": \"brand-postman\"\n}" }, "url": "{{baseUrl}}/admin/brands" } },
            { "name": "Category attributes", "request": { "method": "GET", "url": "{{baseUrl}}/admin/categories/{{categoryId}}/attributes" } }
          ]
        },
        {
          "name": "Products",
          "item": [
            { "name": "Create product", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"brandId\": {{brandId}},\n  \"name\": \"Product Postman\",\n  \"sku\": \"PM-{{$timestamp}}\",\n  \"price\": 1000000,\n  \"stock\": 10,\n  \"status\": \"ACTIVE\"\n}" }, "url": "{{baseUrl}}/admin/products" } },
            { "name": "Update product", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Product Postman Updated\",\n  \"price\": 1200000\n}" }, "url": "{{baseUrl}}/admin/products/{{productId}}" } },
            { "name": "Delete product", "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/products/{{productId}}" } },
            { "name": "Create variant", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"128GB Black\",\n  \"sku\": \"VAR-{{$timestamp}}\",\n  \"price\": 1100000,\n  \"stock\": 5\n}" }, "url": "{{baseUrl}}/admin/products/{{productId}}/variants" } },
            { "name": "Update variant", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"price\": 1150000,\n  \"stock\": 8\n}" }, "url": "{{baseUrl}}/admin/variants/{{variantId}}" } },
            { "name": "Delete variant", "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/variants/{{variantId}}" } },
            { "name": "Add product image", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"imageUrl\": \"https://example.com/product.jpg\",\n  \"altText\": \"Product image\",\n  \"sortOrder\": 0\n}" }, "url": "{{baseUrl}}/admin/products/{{productId}}/images" } }
          ]
        },
        {
          "name": "Orders Promotions Reviews",
          "item": [
            { "name": "List all orders", "request": { "method": "GET", "url": "{{baseUrl}}/admin/orders?page=1&limit=20" } },
            { "name": "Order detail (admin)", "request": { "method": "GET", "url": "{{baseUrl}}/admin/orders/{{orderId}}" } },
            { "name": "Update order status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\"\n}" }, "url": "{{baseUrl}}/admin/orders/{{orderId}}/status" } },
            { "name": "List promotions", "request": { "method": "GET", "url": "{{baseUrl}}/admin/promotions" } },
            { "name": "Create promotion", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"code\": \"PM{{$timestamp}}\",\n  \"name\": \"Postman promotion\",\n  \"discountType\": \"PERCENT\",\n  \"discountValue\": 10\n}" }, "url": "{{baseUrl}}/admin/promotions" } },
            { "name": "Update promotion", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated promotion\"\n}" }, "url": "{{baseUrl}}/admin/promotions/{{promotionId}}" } },
            { "name": "Delete promotion", "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/promotions/{{promotionId}}" } },
            { "name": "List reviews", "request": { "method": "GET", "url": "{{baseUrl}}/admin/reviews?page=1&limit=20" } },
            { "name": "Update review status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"APPROVED\"\n}" }, "url": "{{baseUrl}}/admin/reviews/{{reviewId}}/status" } },
            { "name": "Reply review", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reply\": \"Cam on ban da danh gia san pham\"\n}" }, "url": "{{baseUrl}}/admin/reviews/{{reviewId}}/reply" } }
          ]
        },
        {
          "name": "Inventory Dashboard",
          "item": [
            { "name": "Inventory list", "request": { "method": "GET", "url": "{{baseUrl}}/admin/inventory?page=1&limit=20" } },
            { "name": "Inventory transactions", "request": { "method": "GET", "url": "{{baseUrl}}/admin/inventory/transactions?page=1&limit=20" } },
            { "name": "Low stock", "request": { "method": "GET", "url": "{{baseUrl}}/admin/inventory/low-stock" } },
            { "name": "Dashboard summary", "request": { "method": "GET", "url": "{{baseUrl}}/admin/dashboard/summary" } },
            { "name": "Dashboard revenue", "request": { "method": "GET", "url": "{{baseUrl}}/admin/dashboard/revenue" } },
            { "name": "Orders by status", "request": { "method": "GET", "url": "{{baseUrl}}/admin/dashboard/orders-by-status" } },
            { "name": "Top products", "request": { "method": "GET", "url": "{{baseUrl}}/admin/dashboard/top-products" } },
            { "name": "Recent orders", "request": { "method": "GET", "url": "{{baseUrl}}/admin/dashboard/recent-orders" } },
            { "name": "Dashboard low stock", "request": { "method": "GET", "url": "{{baseUrl}}/admin/dashboard/low-stock" } }
          ]
        }
      ]
    },
    {
      "name": "User",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userAccessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Profile Addresses",
          "item": [
            { "name": "Get profile", "request": { "method": "GET", "url": "{{baseUrl}}/users/me" } },
            { "name": "Update profile", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"User Postman\"\n}" }, "url": "{{baseUrl}}/users/me" } },
            { "name": "Change password", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{userPassword}}\",\n  \"newPassword\": \"Password456!\"\n}" }, "url": "{{baseUrl}}/users/me/password" } },
            { "name": "List addresses", "request": { "method": "GET", "url": "{{baseUrl}}/addresses" } },
            { "name": "Create address", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"receiverName\": \"User Postman\",\n  \"receiverPhone\": \"0900000000\",\n  \"province\": \"Ha Noi\",\n  \"district\": \"Dong Da\",\n  \"ward\": \"Lang Ha\",\n  \"addressLine\": \"12 Nguyen Chi Thanh\",\n  \"addressType\": \"HOME\",\n  \"isDefault\": true\n}" }, "url": "{{baseUrl}}/addresses" } },
            { "name": "Update address", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"addressLine\": \"20 Nguyen Chi Thanh\"\n}" }, "url": "{{baseUrl}}/addresses/{{addressId}}" } },
            { "name": "Set default address", "request": { "method": "PATCH", "url": "{{baseUrl}}/addresses/{{addressId}}/default" } },
            { "name": "Delete address", "request": { "method": "DELETE", "url": "{{baseUrl}}/addresses/{{addressId}}" } }
          ]
        },
        {
          "name": "Cart Favorites",
          "item": [
            { "name": "Get cart", "request": { "method": "GET", "url": "{{baseUrl}}/cart" } },
            { "name": "Add cart item", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"productId\": {{productId}},\n  \"variantId\": null,\n  \"quantity\": 1\n}" }, "url": "{{baseUrl}}/cart/items" } },
            { "name": "Update cart item", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" }, "url": "{{baseUrl}}/cart/items/{{cartItemId}}" } },
            { "name": "Delete cart item", "request": { "method": "DELETE", "url": "{{baseUrl}}/cart/items/{{cartItemId}}" } },
            { "name": "Clear cart", "request": { "method": "DELETE", "url": "{{baseUrl}}/cart" } },
            { "name": "List favorites", "request": { "method": "GET", "url": "{{baseUrl}}/favorites" } },
            { "name": "Add favorite", "request": { "method": "POST", "url": "{{baseUrl}}/favorites/{{productId}}" } },
            { "name": "Remove favorite", "request": { "method": "DELETE", "url": "{{baseUrl}}/favorites/{{productId}}" } }
          ]
        },
        {
          "name": "Orders Payments Promotions Reviews Notifications",
          "item": [
            { "name": "Checkout", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"addressId\": {{addressId}},\n  \"shippingMethodId\": {{shippingMethodId}},\n  \"promotionCode\": null,\n  \"paymentMethod\": \"COD\"\n}" }, "url": "{{baseUrl}}/orders" } },
            { "name": "My orders", "request": { "method": "GET", "url": "{{baseUrl}}/orders/my-orders?page=1&limit=20" } },
            { "name": "Order detail", "request": { "method": "GET", "url": "{{baseUrl}}/orders/{{orderId}}" } },
            { "name": "Cancel order", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Changed mind\"\n}" }, "url": "{{baseUrl}}/orders/{{orderId}}/cancel" } },
            { "name": "Create COD payment", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/payments/{{orderId}}/create" } },
            { "name": "Payment detail", "request": { "method": "GET", "url": "{{baseUrl}}/payments/{{orderId}}" } },
            { "name": "Validate promotion", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"code\": \"{{promotionCode}}\"\n}" }, "url": "{{baseUrl}}/promotions/validate" } },
            { "name": "Create review", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"San pham tot\",\n  \"images\": []\n}" }, "url": "{{baseUrl}}/products/{{productId}}/reviews" } },
            { "name": "Update review", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"rating\": 4,\n  \"comment\": \"Da cap nhat\"\n}" }, "url": "{{baseUrl}}/reviews/{{reviewId}}" } },
            { "name": "Delete review", "request": { "method": "DELETE", "url": "{{baseUrl}}/reviews/{{reviewId}}" } },
            { "name": "List notifications", "request": { "method": "GET", "url": "{{baseUrl}}/notifications?page=1&limit=20" } },
            { "name": "Unread count", "request": { "method": "GET", "url": "{{baseUrl}}/notifications/unread-count" } },
            { "name": "Mark notification read", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/notifications/{{notificationId}}/read" } },
            { "name": "Mark all notifications read", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/notifications/read-all" } }
          ]
        }
      ]
    },
    {
      "name": "Cong khai",
      "item": [
        { "name": "Health check", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
        {
          "name": "Register",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"New Postman User\",\n  \"email\": \"new{{$timestamp}}@example.com\",\n  \"phone\": \"0900000000\",\n  \"password\": \"Password123!\"\n}" }, "url": "{{baseUrl}}/auth/register" }
        },
        {
          "name": "Login User - luu token",
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.data) { pm.collectionVariables.set('userAccessToken', body.data.accessToken); pm.collectionVariables.set('refreshToken', body.data.refreshToken); }"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }
        },
        {
          "name": "Login Admin - luu token",
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.data) { pm.collectionVariables.set('adminAccessToken', body.data.accessToken); pm.collectionVariables.set('refreshToken', body.data.refreshToken); }"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }
        },
        { "name": "Refresh token", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }, "url": "{{baseUrl}}/auth/refresh-token" } },
        { "name": "List categories", "request": { "method": "GET", "url": "{{baseUrl}}/categories" } },
        { "name": "List brands", "request": { "method": "GET", "url": "{{baseUrl}}/brands" } },
        { "name": "List products", "request": { "method": "GET", "url": "{{baseUrl}}/products?search=&sort=newest&page=1&limit=20" } },
        { "name": "Product detail by ID", "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" } },
        { "name": "Product detail by slug", "request": { "method": "GET", "url": "{{baseUrl}}/products/slug/{{productSlug}}" } },
        { "name": "List product reviews", "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}/reviews?page=1&limit=20" } }
      ]
    }
  ]
}
