          "name": "Login Admin",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Admin login thành công', () => pm.response.to.have.status(200));",
              "const json=pm.response.json(); if(json.data) { pm.collectionVariables.set('adminAccessToken',json.data.accessToken); pm.collectionVariables.set('accessToken',json.data.accessToken); }"
            ] }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        { "name": "List Users", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/admin/users?page=1&limit=20" } },
