    {
      "name": "Orders",
      "item": [
        {
          "name": "Checkout",
          "event": [{ "listen": "test", "script": { "exec": ["const j=pm.response.json(); if(j.data) pm.collectionVariables.set('orderId',j.data.order.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"addressId\": {{addressId}},\n  \"shippingMethodId\": {{shippingMethodId}},\n  \"promotionCode\": null,\n  \"paymentMethod\": \"COD\"\n}" },
            "url": "{{baseUrl}}/orders"
          }
        },
        { "name": "My Orders", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/orders/my-orders?page=1&limit=20" } },
        { "name": "Order Detail", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/orders/{{orderId}}" } },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Khách hàng thay đổi nhu cầu\"\n}" },
            "url": "{{baseUrl}}/orders/{{orderId}}/cancel"
          }
        }
      ]
