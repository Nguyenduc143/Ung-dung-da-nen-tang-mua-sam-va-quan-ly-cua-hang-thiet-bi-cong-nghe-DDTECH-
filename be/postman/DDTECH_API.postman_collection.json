    {
      "name": "Reviews",
      "item": [
        { "name": "List Product Reviews", "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/products/{{productId}}/reviews?page=1&limit=20" } },
