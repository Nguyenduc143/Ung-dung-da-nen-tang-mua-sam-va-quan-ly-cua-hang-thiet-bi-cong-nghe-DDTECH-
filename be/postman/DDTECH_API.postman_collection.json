            "body": { "mode": "raw", "raw": "{\n  \"code\": \"POSTMAN10\",\n  \"name\": \"Giảm 10%\",\n  \"discountType\": \"PERCENT\",\n  \"discountValue\": 10,\n  \"maxDiscount\": 500000,\n  \"minOrderValue\": 1000000,\n  \"startDate\": \"2026-01-01T00:00:00.000Z\",\n  \"endDate\": \"2030-12-31T23:59:59.000Z\"\n}" },
            "url": "{{baseUrl}}/admin/promotions"
