        { "name": "Add Favorite", "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/favorites/{{productId}}" } },
        { "name": "Delete Favorite", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/favorites/{{productId}}" } }
      ]
