          "name": "Add Cart Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": {{productId}},\n  \"variantId\": null,\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/cart/items"
          }
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "PATCH",
