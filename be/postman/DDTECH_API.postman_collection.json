{
  "info": {
    "_postman_id": "7ad3184d-d78f-4f6d-a00d-ddtech-part16",
    "name": "DDTECH Backend API - Parts 01-16",
    "description": "Collection tổng hợp API DDTECH. Chạy Login User/Admin trước và điền các biến ID theo dữ liệu local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Nguyễn Văn Test\",\n  \"email\": \"{{userEmail}}\",\n  \"phone\": \"{{userPhone}}\",\n  \"password\": \"{{userPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login User",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Login thành công', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "if (json.data) { pm.collectionVariables.set('accessToken', json.data.accessToken); pm.collectionVariables.set('refreshToken', json.data.refreshToken); }"
            ] }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Current User",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Refresh Token",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const json = pm.response.json();",
              "if (json.data) { pm.collectionVariables.set('accessToken', json.data.accessToken); pm.collectionVariables.set('refreshToken', json.data.refreshToken); }"
            ] }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/refresh-token"
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Logout All",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/auth/logout-all" }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "Get Profile", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/users/me" } },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Nguyễn Văn Test Updated\",\n  \"gender\": \"OTHER\"\n}" },
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{userPassword}}\",\n  \"newPassword\": \"Password456!\"\n}" },
            "url": "{{baseUrl}}/users/me/password"
          }
        },
        { "name": "List Addresses", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/addresses" } },
        {
          "name": "Create Address",
          "event": [{ "listen": "test", "script": { "exec": ["const j=pm.response.json(); if(j.data) pm.collectionVariables.set('addressId',j.data.address.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"receiverName\": \"Nguyễn Văn Test\",\n  \"receiverPhone\": \"{{userPhone}}\",\n  \"province\": \"Hà Nội\",\n  \"district\": \"Đống Đa\",\n  \"ward\": \"Láng Hạ\",\n  \"addressLine\": \"12 Nguyễn Chí Thanh\",\n  \"addressType\": \"HOME\",\n  \"isDefault\": true\n}" },
            "url": "{{baseUrl}}/addresses"
          }
        },
        { "name": "Set Default Address", "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/addresses/{{addressId}}/default" } },
        { "name": "Delete Address", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/addresses/{{addressId}}" } }
      ]
    },
    {
      "name": "Products",
      "item": [
        { "name": "List Products", "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/products?search=&sort=newest&page=1&limit=20" } },
