# Development fallback. Khi chạy `expo start --lan`, app tự thay localhost
# bằng IP của Metro để điện thoại thật kết nối được sau mỗi lần đổi Wi-Fi.
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Production: thay hai URL trên bằng domain HTTPS thật của backend.
